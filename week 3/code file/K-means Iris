# ----------------------------- 2. 数据预处理 -----------------------------
# 标准化（Z-score）: (x - mean) / std
# 为什么？K-Means 基于欧氏距离，不同量纲会影响距离计算
def standardize(X):
    mean = np.mean(X, axis=0)
    std = np.std(X, axis=0)
    X_std = (X - mean) / std
    return X_std, mean, std

X_std, mean, std = standardize(X)
print("\n标准化后的特征均值：", np.mean(X_std, axis=0))
print("标准化后的特征标准差：", np.std(X_std, axis=0))

# ----------------------------- 3. K-Means 算法实现 -----------------------------
def kmeans(X, k, max_iters=100, random_state=42):
    """
    手写 K-Means 聚类
    参数：
        X: ndarray, 样本矩阵 (n_samples, n_features)
        k: int, 聚类数
        max_iters: int, 最大迭代次数
        random_state: int, 随机种子，保证结果可复现
    返回：
        centroids: ndarray, 最终的中心点 (k, n_features)
        labels: ndarray, 每个样本所属簇的索引 (n_samples,)
        inertia: float, 簇内平方和（用于评估收敛）
    """
    np.random.seed(random_state)
    n_samples, n_features = X.shape

    # 1. 随机初始化 k 个中心点（从样本中随机选择）
    idx = np.random.choice(n_samples, k, replace=False)
    centroids = X[idx].copy()

    # 记录历史中心点，用于判断收敛
    old_centroids = np.zeros_like(centroids)
    labels = np.zeros(n_samples, dtype=int)

    # 2. 迭代优化
    for iteration in range(max_iters):
        # ----- 分配阶段：计算每个样本到所有中心点的距离，选择最近的簇 -----
        # 使用欧氏距离（向量化计算，避免循环）
        # 方法：||x - c||^2 = sum(x^2) + sum(c^2) - 2*x·c
        # 但为清晰，直接计算所有距离矩阵
        distances = np.zeros((n_samples, k))
        for i in range(k):
            # 计算第 i 个中心点到所有样本的欧氏距离
            distances[:, i] = np.linalg.norm(X - centroids[i], axis=1)

        # 每个样本选择距离最小的中心点索引
        labels = np.argmin(distances, axis=1)

        # ----- 更新阶段：重新计算每个簇的中心点 -----
        old_centroids = centroids.copy()
        for i in range(k):
            # 找到属于簇 i 的所有样本
            cluster_points = X[labels == i]
            if len(cluster_points) > 0:
                centroids[i] = np.mean(cluster_points, axis=0)
            # 如果某个簇没有样本，可以保留原中心点或重新初始化（这里保留原值）

        # ----- 判断收敛：如果中心点不再变化，则停止 -----
        if np.allclose(centroids, old_centroids):
            print(f"收敛于第 {iteration+1} 次迭代")
            break

    # 计算簇内平方和（inertia），用于评估聚类的紧密程度
    inertia = 0
    for i in range(k):
        cluster_points = X[labels == i]
        if len(cluster_points) > 0:
            inertia += np.sum((cluster_points - centroids[i]) ** 2)

    return centroids, labels, inertia



# 4.2 内部评估：轮廓系数（Silhouette Coefficient）
# 手写实现，无需 sklearn
def silhouette_score_manual(X, labels):
    n_samples = len(X)
    # 手写计算欧氏距离矩阵（完全替代scipy的pdist/squareform）
    distances = np.zeros((n_samples, n_samples))
    for i in range(n_samples):
        for j in range(i+1, n_samples):
            dist = np.linalg.norm(X[i] - X[j])
            distances[i, j] = dist
            distances[j, i] = dist  # 距离矩阵对称

    s_i = np.zeros(n_samples)
    for i in range(n_samples):
        cluster = labels[i]
        same_cluster_idx = np.where(labels == cluster)[0]
        # 计算a_i：同簇内到其他样本的平均距离
        if len(same_cluster_idx) > 1:
            a_i = np.mean(distances[i, same_cluster_idx[same_cluster_idx != i]])
        else:
            a_i = 0.0

        # 计算b_i：最近的其他簇的平均距离
        b_i = float('inf')
        other_clusters = np.unique(labels)
        for other in other_clusters:
            if other == cluster:
                continue
            other_idx = np.where(labels == other)[0]
            if len(other_idx) > 0:
                mean_dist = np.mean(distances[i, other_idx])
                if mean_dist < b_i:
                    b_i = mean_dist

        if b_i == float('inf'):
            b_i = 0
        if max(a_i, b_i) != 0:
            s_i[i] = (b_i - a_i) / max(a_i, b_i)
        else:
            s_i[i] = 0
    return np.mean(s_i)



# ========================= 肘部法则确定最佳 K =========================
# 计算 K 从 1 到 10 的 inertia 和轮廓系数
K_range = range(1, 11)
inertias = []
silhouettes = []

for k in K_range:
    if k == 1:
        _, _, inertia = kmeans(X_std, k, max_iters=100)
        inertias.append(inertia)
        silhouettes.append(0)   # K=1 轮廓系数无定义
    else:
        _, labels_k, inertia = kmeans(X_std, k, max_iters=100)
        inertias.append(inertia)
        sil = silhouette_score_manual(X_std, labels_k)  # 这里 silhouette_score_manual 在后面定义，暂时会报错，需要先移动函数定义
        silhouettes.append(sil)
plt.figure(figsize=(6, 4))
plt.plot(K_range, inertias, 'bo-')
plt.xlabel('K')
plt.ylabel('簇内平方和 (Inertia)')
plt.title('肘部法则')
plt.show()

# 根据肘部图手动确定最佳 K
best_K = 3
print(f"根据肘部法则，选择最佳 K = {best_K}")

# ========================= 6. 最终聚类（使用 best_K）=========================
K = best_K
centroids, labels, inertia = kmeans(X_std, K, max_iters=100)
print(f"\nK-Means 聚类完成(K={K})，簇内平方和 (inertia) = {inertia:.4f}")

# ----------------------------- 4. 模型评估 -----------------------------
# 4.1 外部评估：纯度（Purity），需要真实标签
# 将真实标签映射为数字（Iris-setosa=0, Iris-versicolor=1, Iris-virginica=2）
species_to_int = {'Iris-setosa': 0, 'Iris-versicolor': 1, 'Iris-virginica': 2}
y_true_int = np.array([species_to_int[s] for s in y_true])

def purity(y_true, y_pred):
    from collections import defaultdict
    cluster_classes = defaultdict(lambda: defaultdict(int))
    for i, (t, p) in enumerate(zip(y_true, y_pred)):
        cluster_classes[p][t] += 1
    majority_sum = 0
    for p in cluster_classes:
        majority_sum += max(cluster_classes[p].values())
    return majority_sum / len(y_true)

purity_score = purity(y_true_int, labels)
print(f"聚类纯度 (Purity) = {purity_score:.4f}")

sil_score = silhouette_score_manual(X_std, labels)
print(f"轮廓系数 (Silhouette Coefficient) = {sil_score:.4f}")


