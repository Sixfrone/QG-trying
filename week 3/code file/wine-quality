# ========================= 5. ROC曲线和AUC（手动计算） =========================
# 为了更全面评估分类器，手动计算ROC曲线下的面积（AUC）
def roc_curve_manual(y_true, y_score, n_thresholds=100):
    """
    手动计算ROC曲线的FPR和TPR
    参数:
        y_true: 真实标签 (0/1)
        y_score: 预测为正类的概率
        n_thresholds: 阈值数量（在0-1之间均匀取点）
    返回:
        fpr: 假阳性率列表
        tpr: 真阳性率列表
        auc: 曲线下面积
    """
    thresholds = np.linspace(0, 1, n_thresholds)
    fpr = []
    tpr = []
    for thresh in thresholds:
        y_pred = (y_score >= thresh).astype(int)
        # 计算TP, FP, FN, TN
        tp = np.sum((y_true == 1) & (y_pred == 1))
        fp = np.sum((y_true == 0) & (y_pred == 1))
        fn = np.sum((y_true == 1) & (y_pred == 0))
        tn = np.sum((y_true == 0) & (y_pred == 0))
        tpr.append(tp / (tp + fn) if (tp+fn) > 0 else 0)
        fpr.append(fp / (fp + tn) if (fp+tn) > 0 else 0)
    # 排序确保点顺序
    fpr = np.array(fpr)
    tpr = np.array(tpr)
    # 按fpr升序排序
    sorted_idx = np.argsort(fpr)
    fpr = fpr[sorted_idx]
    tpr = tpr[sorted_idx]
    # 计算AUC（梯形法则）
    auc = np.trapz(tpr, fpr)
    return fpr, tpr, auc

# 获取测试集预测概率
y_score = log.predict_proba(X_test_bias)
fpr, tpr, auc = roc_curve_manual(y_bin_test, y_score)

# 绘制ROC曲线
