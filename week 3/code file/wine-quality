# 2.1 标准化（Z-score）
def standardize(X):
    #将特征矩阵标准化为均值0，标准差1
    # 核心公式：标准化（把数值拉到一个量级），每个数据 = (原数据 - 该列均值) / 该列标准差
    mean = np.mean(X, axis=0) #计算每一列特征的平均值
    std = np.std(X, axis=0) #计算每一列特征的标准差
    # 避免除以0（如果有常数特征）
    std[std == 0] = 1
    X_std = (X - mean) / std
    return X_std, mean, std #特征矩阵

X_std, mean_X, std_X = standardize(X)

# 2.2 手动划分80%训练集和20%测试集（省略调参）
def train_test_split_manual(X, y_reg, y_bin, test_size=0.2, random_state=42):
    np.random.seed(random_state)
    n_samples = X.shape[0]
    indices = np.random.permutation(n_samples)
    test_count = int(n_samples * test_size)
    test_idx = indices[:test_count]
    train_idx = indices[test_count:]
    return (X[train_idx], X[test_idx],
            y_reg[train_idx], y_reg[test_idx],
            y_bin[train_idx], y_bin[test_idx])

# 调用一次划分，同时得到回归和分类的训练/测试集
X_train, X_test, y_reg_train, y_reg_test, y_bin_train, y_bin_test = train_test_split_manual(X_std, y_reg, y_bin, test_size=0.2)


